---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import PlanCard from "../components/PlanCard.astro";
import { githubStarsLabel } from "../github";
import BaseLayout from "../layouts/BaseLayout.astro";
import { PRICING_PLANS } from "../pricing";
import { pricingStructuredData } from "../structured-data";

const starsLabel = await githubStarsLabel();
---

<BaseLayout
  title="Pricing · Stirrup"
  markdownAlternate="/pricing.md"
  structuredData={pricingStructuredData()}
  description="Self-host Stirrup for free, or contact SaddleTree about deployment and support."
>
  <div class="container">
    <Header starsLabel={starsLabel} />
    <main id="main" class="pricing">
      <h1 class="section-heading">Pricing</h1>
      <div class="pricing__plans">
        {
          PRICING_PLANS.map((plan, index) => (
            <PlanCard plan={plan} primary={index > 0} attr={`pricing-${index}`} />
          ))
        }
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
