{
  "name": "@rakazo/edition-law",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./web": {
      "types": "./src/web.ts",
      "development": "./src/web.ts",
      "default": "./src/web.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "development": "./src/server.ts",
      "default": "./src/server.ts"
    }
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. editions/law/src",
    "seed": "tsx src/server/cli/seed.ts",
    "avatars:backfill": "tsx src/server/cli/avatars-backfill.ts",
    "encrypt:backfill": "tsx src/server/cli/encrypt.ts backfill",
    "encrypt:decrypt": "tsx src/server/cli/encrypt.ts decrypt",
    "encrypt:reencrypt": "tsx src/server/cli/encrypt.ts reencrypt",
    "media:doctor": "tsx src/server/media/main.ts media:doctor",
    "media:dev": "tsx src/server/media/main.ts",
    "case:purge": "tsx src/server/cli/case-purge.ts",
    "case:hold": "tsx src/server/cli/case-hold.ts"
  },
  "dependencies": {
    "@lingui/core": "6.12.0",
    "@lingui/react": "6.12.0",
    "@rakazo/adapter-kit": "workspace:*",
    "@rakazo/adapters": "workspace:*",
    "@rakazo/contracts": "workspace:*",
    "@rakazo/core": "workspace:*",
    "@rakazo/db": "workspace:*",
    "@rakazo/edition-sdk": "workspace:*",
    "@rakazo/logging": "workspace:*",
    "@rakazo/ui-web": "workspace:*",
    "hono": "4.13.17",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
